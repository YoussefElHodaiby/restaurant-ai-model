# ── Local development ──────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
VITE_API_URL=http://localhost:8000

# ── Production (Vercel + Supabase) ─────────────────────────────────
# Supabase PostgreSQL URI — Supabase dashboard → Settings → Database → URI
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Set VITE_API_URL=/api in Vercel env vars so the frontend calls the Vercel function
# VITE_API_URL=/api

# Optional: extra CORS origins (comma-separated custom domains)
# ALLOWED_ORIGINS=https://yourdomain.com
